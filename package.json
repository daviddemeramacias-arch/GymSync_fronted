{
  "name": "admin-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tokens:transform": "token-transformer ../DESIGN_TOKENS.json tokens/tokens.json",
    "tokens:build": "npm run tokens:transform && style-dictionary build --config tokens/style-dictionary.config.js",
    "start": "npm run tokens:build && ng serve",
    "build": "npm run tokens:build && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@12.2.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "style-dictionary": "^4.4.0",
    "token-transformer": "^0.0.33",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
